rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read: if request.auth != null;
      // O admin (mesmo email/senha do painel) pode liberar/revogar
      // assinatura de qualquer usuário; os demais só editam o próprio perfil.
      allow write: if request.auth != null &&
        (request.auth.uid == uid || request.auth.token.email == 'victorjg10@admin.com');

      // Dados de Financeiro/Home da versão web (saídas, dias, gastos, meses
      // fechados) — só o dono da conta acessa, ninguém mais lê ou escreve.
      match /saidasAtivas/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /dias/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /gastos/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /mesesFechados/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Dados de conta de restaurante (Fase 11): taxa por bairro e
      // motoboys vinculados — só o próprio restaurante escreve. Leitura de
      // bairros é aberta a qualquer conta autenticada (Fase 11.1): o app
      // do motoboy precisa ler os bairros de um restaurante pra calcular a
      // sobreposição de taxa (ver lib/restaurante/taxa_override_service.dart),
      // não só o dono da conta.
      match /bairros/{id} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /motoboys/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /conversas/{conversaId} {
      // resource == null cobre o caso de checar se a conversa já existe
      // antes de criá-la (abrirConversa) — sem isso, o "get" de um doc
      // inexistente é negado e a primeira conversa nunca consegue ser criada.
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.participantes);
      allow update: if request.auth != null && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantes;

      match /mensagens/{msgId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversas/$(conversaId)).data.participantes;
      }
    }

    match /grupos/{grupoId} {
      // resource == null cobre o bootstrap do Chat Geral (garantirChatGeral
      // faz um "get" antes de criar o doc na primeira vez que alguém abre o
      // Chat) e a checagem de existência ao criar grupos novos.
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.membros);
      allow create: if request.auth != null;
      // Permite entrar no grupo (aceitar convite) mesmo antes de ser membro.
      allow update: if request.auth != null;

      match /mensagens/{msgId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/grupos/$(grupoId)).data.membros;
      }
    }

    match /convites/{conviteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.convidadoUid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.convidadoUid;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 2000
        && request.resource.data.likedBy == []
        && request.resource.data.commentsCount == 0;

      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;

      // autor edita o próprio post OU alguém curte/descurte OU o contador de
      // comentários sobe/desce em 1 junto de um comentário
      allow update: if request.auth != null && (
        resource.data.authorUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
      );

      match /comentarios/{comentarioId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 1000;
        allow update: if false;
        allow delete: if request.auth != null
          && resource.data.autorUid == request.auth.uid;
      }
    }
  }
}
