{
  "name": "motoca-premium-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply:local": "wrangler d1 execute motoca-premium-db --local --file=./db/schema.sql",
    "db:apply:remote": "wrangler d1 execute motoca-premium-db --remote --file=./db/schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "sharp": true
  }
}
