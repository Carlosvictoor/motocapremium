{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "build/web"
  },
  "routes": [
    { "pattern": "motocapremium.com", "custom_domain": true },
    { "pattern": "www.motocapremium.com", "custom_domain": true }
  ]
}
